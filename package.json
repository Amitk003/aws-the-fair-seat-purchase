{
  "name": "the-fair-seat-purchase",
  "version": "1.0.0",
  "private": true,
  "description": "High-concurrency ticket booking system on AWS serverless",
  "scripts": {
    "seed": "node tools/seed-stadium.js",
    "test:unit": "jest tests/unit",
    "test:load": "artillery run tests/load/hold-only.yml",
    "test:load:checkout": "artillery run tests/load/full-checkout.yml"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-scheduler": "^3.600.0",
    "@aws-sdk/client-sfn": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "artillery": "^2.0.33",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  }
}
